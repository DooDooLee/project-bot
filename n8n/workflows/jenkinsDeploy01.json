{
  "id": "jenkinsDeploy01",
  "name": "Jenkins 배포 알림 (시작, 성공, 실패)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "nodes": [
    {
      "id": "jenkinsDeploy01-1",
      "name": "알림 받기",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "jenkinsDeploy01-hook",
      "parameters": {
        "httpMethod": "POST",
        "path": "jenkins",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "jenkinsDeploy01-2",
      "name": "봇 API로 전달",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_API_URL }}/hooks/jenkins",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $json.headers['x-webhook-secret'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 5000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "jenkinsDeploy01-3",
      "name": "응답",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "알림 받기": {
      "main": [
        [
          {
            "node": "봇 API로 전달",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "봇 API로 전달": {
      "main": [
        [
          {
            "node": "응답",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}