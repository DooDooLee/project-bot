      "webhookId": "inboundGateway01-github"
    },
    {
      "id": "inboundGateway01-8",
      "name": "종류별로 나누기",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        340,
        230
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "inboundGateway01-rule-봇을 부름",
                    "leftValue": "={{ $('Slack').isExecuted && !$json.headers['x-slack-retry-num'] && ($json.body.event || {}).type === 'app_mention' && !($json.body.event || {}).bot_id }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "봇을 부름"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "inboundGateway01-rule-버튼 누름",
                    "leftValue": "={{ $('Slack').isExecuted && String($json.body.payload || '').replace(/\\s/g, '').includes('\"type\":\"block_actions\"') }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "버튼 누름"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "inboundGateway01-rule-배포 알림",
                    "leftValue": "={{ $('Jenkins').isExecuted && ['STARTED', 'SUCCESS', 'FAILURE', 'UNSTABLE', 'ABORTED'].includes(String($json.body.status || '').toUpperCase()) }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "배포 알림"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "inboundGateway01-rule-PR 합쳐짐",
                    "leftValue": "={{ $('GitHub').isExecuted && $json.body.action === 'closed' && ($json.body.pull_request || {}).merged === true }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "PR 합쳐짐"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "버림"
        }
      }
    },
    {
      "id": "inboundGateway01-9",
      "name": "봇 API로: 봇을 부름",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        -20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_API_URL }}/slack/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-slack-signature",
              "value": "={{ $json.headers['x-slack-signature'] }}"
            },
            {
              "name": "x-slack-request-timestamp",
              "value": "={{ $json.headers['x-slack-request-timestamp'] }}"
            },
            {
              "name": "content-type",
              "value": "application/octet-stream"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 2500,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "inboundGateway01-10",
      "name": "봇 API로: 버튼 누름",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BOT_API_URL }}/slack/actions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-slack-signature",
              "value": "={{ $json.headers['x-slack-signature'] }}"
