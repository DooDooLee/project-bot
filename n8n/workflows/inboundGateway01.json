    {
      "id": "inboundGateway01-13",
      "name": "받았다고 답함",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1060,
        230
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json.statusCode ? ($json.body || {}) : ($json.error ? { ok: false } : ((($json.body || {}).type === 'url_verification') ? { challenge: $json.body.challenge || '' } : { ok: true, ignored: true }))) }}",
        "options": {
          "responseCode": "={{ $json.statusCode || ($json.error ? 502 : 200) }}"
        }
      }
    },
    {
      "id": "inboundGateway01-14",
      "name": "메모: ⑤ 봇의 결과 받기",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -70,
        650
