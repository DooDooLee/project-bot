      "typeVersion": 2,
      "position": [
        0,
        760
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "internal/result",
        "responseMode": "lastNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "webhookId": "inboundGateway01-internal-result",
      "credentials": {
        "httpHeaderAuth": {
          "id": "internalHook01",
          "name": "봇 내부 요청 확인"
        }
      }
    },
    {
      "id": "inboundGateway01-17",
      "name": "Slack에 올리기",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        340,
        760
      ],
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.body.channel }}"
        },
        "messageType": "block",
        "blocksUi": "={{ JSON.stringify({ blocks: $json.body.blocks }) }}",
        "text": "={{ $json.body.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false,
          "thread_ts": {
            "replyValues": {
              "thread_ts": "={{ $json.body.thread_ts || undefined }}",
              "reply_broadcast": false
            }
          }
        }
      },
      "credentials": {
        "slackApi": {
          "id": "slackBot01",
          "name": "Slack 봇"
        }
      }
    }
