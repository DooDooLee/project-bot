# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 저장소에 올리지 않는다.

# 봇 서버의 HTTPS 주소 (예: 1-2-3-4.sslip.io) 와 앱 서버의 사설 IP
BOT_HOST=
APP_SERVER_IP=

# 임의의 긴 문자열 (openssl rand -hex 24)
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Claude(분석·수정), OpenAI(검색용 임베딩)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Slack 앱 (slack/manifest.example.yml 로 만든 뒤 발급되는 값)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# 수정 브랜치와 PR을 만들 GitHub 토큰, Jenkins 읽기 전용 계정
GITHUB_TOKEN=
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# 봇이 만든 결과 글을 n8n으로 보내는 주소. 비워 두면 n8n 없이 Slack에 직접 올린다
N8N_RESULT_URL=http://n8n:5678/webhook/internal/result
